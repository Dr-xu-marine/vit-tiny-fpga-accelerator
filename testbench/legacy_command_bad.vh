 function automatic bad(input [511:0] c);
  reg [31:0] h,a,b,y,m,k,n,count;reg [63:0] sa,sy,lasts,lastd,nc;
  begin
   h=c[31:0];a=c[63:32];b=c[95:64];y=c[127:96];m=c[159:128];k=c[191:160];n=c[223:192];count=c[255:224];nc=({32'd0,n}+15)>>4;
   bad=(|(h&32'hffffe0f0))||a>=1048576||b>=1048576||y>=1048576;
   sa={32'd0,a}+{32'd0,m}*{32'd0,k};sy={32'd0,y}+{32'd0,m}*{32'd0,n};
   case(h[3:0])
    1,4:bad=bad||m<1||m>197||k<1||k>768||n<1||n>1000||sa>1048576||(h[8]&&{32'd0,k}*nc>16384)||sy>(h[11]?65536:1048576);
    2:bad=bad||(|h[12:8])||m!=1||n!=192||a+192>1048576||y+192>1048576;
    3:bad=bad||(|h[12:8])||n!=197||a+197>65536||y+197>65536;
    5,6,9,10:begin
     bad=bad||(|h[12:8])||count<1||count>151296||{32'd0,y}+count>1048576;
     if(h[3:0]==6)bad=bad||{32'd0,a}+count>1048576||{32'd0,b}+count>1048576;
     if(h[3:0]==5)bad=bad||n<1||n>768||{32'd0,a}+count>1048576;
     if(h[3:0]==9)bad=bad||{32'd0,a}+count>65536;
     if(h[3:0]==10)bad=bad||count!=37824||n!=192||{32'd0,a}+37632>1048576;
    end
    7:begin
     lasts={32'd0,a}+({32'd0,m}-1)*{32'd0,c[447:416]}+({32'd0,n}-1)*{32'd0,c[479:448]};
     lastd={32'd0,y}+({32'd0,m}-1)*{32'd0,c[511:480]}+({32'd0,n}-1)*{32'd0,c[415:384]};
     bad=bad||h[8]||h[9]||h[11]||h[12]||m<1||m>768||n<1||n>768||lasts>=1048576||lastd>=(h[10]?262144:1048576);
    end
    default:bad=1;
   endcase
  end
 endfunction
